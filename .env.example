# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL or Neon DB)
DATABASE_URL="postgresql://username:password@localhost:5432/vims_database?schema=public"

# Authentication Security
JWT_SECRET="your_super_secret_jwt_key_here"

# Frontend Client URL
FRONTEND_URL="http://localhost:5173"

# Email Dispatcher Service (Optional)
EMAIL_USER="your-notification-email@gmail.com"
EMAIL_PASS="your-email-app-password"
API_KEY="your-resend-api-key"
